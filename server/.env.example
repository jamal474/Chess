# Node server bind
NODE_HOST=0.0.0.0
NODE_PORT=3000

# Where the C++ game engine is reachable
CPP_HOST=localhost
CPP_PORT=5000

# socket.io endpoint path — must be identical to what the browser requests.
# The client is mounted at /chess/, and nginx forwards that URI through
# unchanged, so any deployment sitting behind nginx needs:
#   SOCKET_IO_PATH=/chess/socket.io/
# Leave it unset for a bare relay you connect to directly (VITE_SERVER_URL on
# the client), which answers on its own root.
SOCKET_IO_PATH=/socket.io/

# CORS for the React client; comma-separated origins, "*" allowed for local dev
ALLOWED_ORIGINS=*
