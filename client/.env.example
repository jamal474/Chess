# Where the browser should connect for the socket.io server.
#
# Leave empty in any deployment where nginx sits in front of both the SPA and
# the relay (Docker Compose, Railway, the short domain): the client then talks
# to its own origin and socket.io's path picks up the app's base — /chess/ by
# default — automatically.
#
# Set it only when pointing the browser straight at the node server, e.g. a
# local `npm run dev` against a relay on port 3000. In that mode the path
# resets to /socket.io/, because the node server answers on its own root.
VITE_SERVER_URL=http://localhost:3000

# Escape hatch if the relay is mounted somewhere neither default covers.
# VITE_SOCKET_PATH=/chess/socket.io/

# Mount path for the built app. Must start and end with "/". The Dockerfile
# derives this from its APP_BASE build arg; set it by hand only for a plain
# `npm run build`.
# BASE_PATH=/chess/
