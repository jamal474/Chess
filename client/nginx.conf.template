# Chess client — static SPA + WebSocket passthrough to the node relay.
#
# Template variables (substituted at container start by entrypoint.sh):
#   ${PORT}       — nginx bind port      (Railway sets automatically; default 80)
#   ${NODE_HOST}  — node relay hostname  (Railway private DNS or compose service)
#   ${NODE_PORT}  — node relay port      (Railway assigns; docker-compose 3000)
#
# Nothing else uses ${…} — everything nginx needs at runtime ($uri, $host,
# $http_upgrade, $remote_addr) is expanded by nginx, not envsubst.

server {
  listen ${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Local health probe — nginx answers it directly. Kept independent of the
  # node upstream on purpose: if node is temporarily down, we still want
  # Railway's healthcheck to pass so the client container doesn't restart
  # in a loop.
  location = /healthz {
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # SPA fallback: any non-file route serves index.html so React Router owns it.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Socket.IO + WebSocket upgrade → node relay.
  location /socket.io/ {
    proxy_pass http://${NODE_HOST}:${NODE_PORT};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
  }
}
